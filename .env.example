# PostgreSQL Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hotel_booking

# Database Connection URL (points to container service 'db' in docker network)
DATABASE_URL=postgresql://postgres:postgres@db:5432/hotel_booking

# Application Environment (development, staging, production)
APP_ENV=production

# Logging Configuration (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Docker Image Name & Tag for API deployments / rollback
IMAGE_NAME=hotel-booking-api
IMAGE_TAG=latest
